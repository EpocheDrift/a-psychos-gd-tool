            "params": {
              "count": 4
            }
          },
          "place": {
            "id": "place",
            "type": "Place",
            "params": {
              "binds": "[{\"channel\":\"image\",\"target\":\"scale\",\"amount\":0.5}]"
            }
          },
          "out": {
            "id": "out",
            "type": "Output",
            "params": {
              "transparent": true
            }
          }
