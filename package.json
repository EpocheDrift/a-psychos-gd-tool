{
  "name": "a-psychos-gd-tool",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "dev": "vite",
    "dev:agent": "npm run build:agent && vite preview --mode agent",
    "build": "tsc -b && vite build && vite build --mode agent && npm run build:mcp",
    "build:agent": "tsc -b && vite build --mode agent",
    "build:mcp": "npm --workspace @a-psychos/gd-mcp-companion run build",
    "check:font": "node scripts/check-font.mjs",
    "check:versions": "node scripts/version-check.mjs",
    "check:agent-artifacts": "node scripts/agent-artifact-check.mjs --build",
    "check:agent-build": "npm run check:agent-artifacts && node scripts/agent-build-check.mjs",
    "check:mcp:authority": "node scripts/mcp-authority-check.mjs",
    "check:mcp:stdio": "node scripts/mcp-stdio-check.mjs",
    "check:mcp": "npm run build:agent && npm run build:mcp && npm run check:mcp:authority && node scripts/mcp-e2e-check.mjs && node scripts/agent-eval-check.mjs && npm run check:mcp:stdio",
    "check:agent-evals": "npm run build:agent && npm run build:mcp && node scripts/agent-eval-check.mjs",
    "mcp:start": "npm run build:agent && npm run build:mcp && npm --workspace @a-psychos/gd-mcp-companion run start --",
    "preview": "vite preview",
    "preview:agent": "vite preview --mode agent",
    "fixtures:update": "vite-node scripts/update-baseline-fixtures.ts",
    "smoke:serve": "npm run build:agent && vite preview --mode agent",
    "smoke:baseline": "node scripts/baseline-check.mjs",
    "smoke:example": "node scripts/factory-check.mjs",
    "smoke:factory": "npm run smoke:example",
    "smoke:frame": "node scripts/verify.mjs",
    "smoke:blur": "node scripts/blur-check.mjs",
    "smoke:fringe": "node scripts/fringe-check.mjs",
    "smoke:interaction": "node scripts/marquee-check.mjs",
    "smoke:render": "node scripts/render-coordinator-check.mjs",
    "smoke:controller": "node scripts/agent-controller-check.mjs",
    "smoke:agent-ui": "node scripts/agent-semantic-check.mjs",
    "smoke:workbench": "node scripts/workbench-layout-check.mjs",
    "smoke:ci": "node scripts/ci-smoke-check.mjs",
    "smoke:all": "npm run smoke:baseline && npm run smoke:example && npm run smoke:controller && npm run smoke:frame && npm run smoke:blur && npm run smoke:fringe && npm run smoke:interaction && npm run smoke:render && npm run smoke:agent-ui && npm run smoke:workbench",
    "test": "vitest run && npm run test:mcp",
    "test:mcp": "npm --workspace @a-psychos/gd-mcp-companion run test && npm run check:mcp:authority",
    "typecheck": "tsc -b && npm --workspace @a-psychos/gd-mcp-companion run typecheck"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@xyflow/react": "^12.11.0",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.60",
    "axe-core": "^4.12.1",
    "puppeteer-core": "^25.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
