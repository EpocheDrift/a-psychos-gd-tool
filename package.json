{
  "name": "a-psychos-gd-tool",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fixtures:update": "vite-node scripts/update-baseline-fixtures.ts",
    "smoke:serve": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "smoke:baseline": "node scripts/baseline-check.mjs",
    "smoke:factory": "node scripts/factory-check.mjs",
    "smoke:frame": "node scripts/verify.mjs",
    "smoke:blur": "node scripts/blur-check.mjs",
    "smoke:fringe": "node scripts/fringe-check.mjs",
    "smoke:interaction": "node scripts/marquee-check.mjs",
    "smoke:render": "node scripts/render-coordinator-check.mjs",
    "smoke:agent-ui": "node scripts/agent-semantic-check.mjs",
    "smoke:all": "npm run smoke:baseline && npm run smoke:factory && npm run smoke:frame && npm run smoke:blur && npm run smoke:fringe && npm run smoke:interaction && npm run smoke:render && npm run smoke:agent-ui",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@xyflow/react": "^12.11.0",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.60",
    "axe-core": "^4.12.1",
    "puppeteer-core": "^25.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
